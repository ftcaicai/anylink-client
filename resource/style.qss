/********** Follow system light / dark palette **********/
QTabBar::tab {
       height: 25px;
       color: palette(window-text);
       background: transparent;
       font: 14px;
       margin-right: 10px;
       margin-left: 10px;
}
QTabBar::tab:hover {
       font: 15px;
       border-bottom: 2px solid palette(mid);
       color: palette(window-text);
       height: 25px;
       margin-right: 10px;
       margin-left: 10px;
}
QTabBar::tab:selected {
       font: 15px;
       border-bottom: 2px solid rgb(45, 105, 65);
       color: palette(window-text);
       height: 25px;
       margin-right: 10px;
       margin-left: 10px;
}
QTabWidget#tabWidget::pane {
       border: 1px solid palette(mid);
       background: palette(base);
       margin-top: 12px;
       color: palette(text);
       border-radius: 10px;
}
QTabWidget#tabWidget QLabel,
QTabWidget#tabWidget QCheckBox {
       color: palette(window-text);
       background: transparent;
}
QTabWidget#tabWidget QPushButton,
QTabWidget#tabWidget QToolButton {
       color: palette(button-text);
       background: palette(button);
       border: 1px solid palette(mid);
       border-radius: 4px;
       padding: 4px 12px;
}
QTabWidget#tabWidget QPushButton:disabled,
QTabWidget#tabWidget QToolButton:disabled {
       color: palette(mid);
}
QTabWidget#tabWidget QComboBox,
QTabWidget#tabWidget QLineEdit {
       color: palette(text);
       background: palette(base);
       border: 1px solid palette(mid);
       border-radius: 4px;
       padding: 3px 6px;
       min-height: 22px;
}
QTabWidget#tabWidget QComboBox QAbstractItemView {
       color: palette(text);
       background: palette(base);
       selection-background-color: palette(highlight);
       selection-color: palette(highlighted-text);
}
QLabel#statusBar {
       color: palette(window-text);
       background: transparent;
}
/********** QListView **********/
QListView {
       color: palette(text);
       background: palette(base);
}
QListView::item {
       margin: 2px;
       font: 18px;
       color: palette(text);
}
QListView::item:selected {
       background: palette(highlight);
       color: palette(highlighted-text);
}
